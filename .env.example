# Copy to .env on each reception laptop. Never commit the real .env.

# --- Supabase (cloud sync) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Same values, exposed to the Vite frontend build.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Hub cloud provisioning (REQUIRED for cloud sync) ---
# The per-restaurant secret this hub presents to bind itself to its tenant.
# Register it once from the Supabase SQL editor:
#
#   SELECT public.set_hub_provisioning_secret('<restaurant-uuid>', '<this-secret>');
#
# Without it the hub still runs fully offline over LAN, but queued orders will
# not sync to the cloud. See database/migrations/001_secure_hub_provisioning.sql.
HUB_PROVISIONING_SECRET=

# --- Optional ---
# PORT=4000
# HUB_DATA_DIR=/absolute/path/to/hub/data
# Require a device token even from the reception laptop itself:
# HUB_TRUST_LOOPBACK=false
# Remove the demo outage-simulator endpoint entirely:
# HUB_DISABLE_OUTAGE_SIM=true
